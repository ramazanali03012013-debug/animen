# Cloudflare yapılandırması
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Cloudflare Turnstile (bot koruması) - https://dash.cloudflare.com/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Türkçe anime embed kaynakları (JSON dizisi). İstediğin kadar kaynak ekleyebilirsin.
# embed şablonunda {id} bölüm/editör id'si, {anime} ise kaynakta kullanılan anime slug/id'sidir.
ANIME_SOURCES=[{"id":"kaynak1","name":"Kaynak 1","embed":"https://embed-ornek1.com/v/{id}","search":"https://api-ornek1.com/search?q={anime}"},{"id":"kaynak2","name":"Kaynak 2","embed":"https://embed-ornek2.com/e/{id}","search":"https://api-ornek2.com/a/{anime}"}]
